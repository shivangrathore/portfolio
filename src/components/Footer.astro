---
import {
  GITHUB_URL,
  LINKEDIN_URL,
  X_URL,
  MAIL_ADDRESS,
  AVAILABILITY,
  RESUME_URL,
} from "@/lib/constants";
import { landings } from "@/lib/landings";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import X from "@/components/icons/X.astro";
import Icon from "@/components/icons/Icon.astro";
import RegionToggle from "@/components/RegionToggle.astro";

const year = new Date().getFullYear();
const freelance = /^\/(services|hire|contact)(\/|$)/.test(Astro.url.pathname);

// The top nav carries four items and cannot grow. Everything worth reaching
// lives here instead. Freelance comes last: it is the secondary path now, still
// one click from every page for the client who does want it.
const columns = [
  {
    title: "Work",
    links: [
      { label: "Projects", href: "/work/" },
      { label: "Case studies", href: "/case-studies/" },
      { label: "Blog", href: "/blog/" },
    ],
  },
  {
    title: "Site",
    links: [
      { label: "About", href: "/about/" },
      { label: "Resume", href: RESUME_URL },
      { label: "RSS", href: "/rss.xml" },
    ],
  },
  {
    title: "Freelance",
    links: [
      // The hub is otherwise orphaned: /services links the landing pages
      // directly and nothing else points at /hire itself.
      { label: "Ways to work together", href: "/hire/" },
      ...landings.map((l) => ({ label: l.eyebrow, href: `/hire/${l.slug}/` })),
      { label: "Services and rates", href: "/services/" },
      { label: "Start a project", href: "/contact/" },
    ],
  },
];

const elsewhere = [
  { label: "GitHub", href: GITHUB_URL, icon: "github" },
  { label: "LinkedIn", href: LINKEDIN_URL, icon: "linkedin" },
  { label: "X", href: X_URL, icon: "x" },
  { label: "Email", href: `mailto:${MAIL_ADDRESS}`, icon: "mail" },
] as const;
---

<footer class="border-t border-line">
  <div class="shell py-16">
    <div class="grid gap-x-12 gap-y-12 lg:grid-cols-12">
      <!-- Sign-off, at display size. The site ends on the name. -->
      <div class="lg:col-span-4">
        <p class="expanded text-heading font-bold tracking-tight text-fg">
          Shivang Rathore
        </p>
        <p class="measure mt-4 text-sm leading-relaxed text-muted">
          Full stack engineer in India. TypeScript and React on the front, Go,
          Python and PostgreSQL behind it. Building software since 2019, and
          open to full-time remote roles.
        </p>
        <a
          href={`mailto:${MAIL_ADDRESS}`}
          class="mt-5 inline-block text-sm text-fg underline decoration-rule underline-offset-4 hover:text-accent hover:decoration-accent"
        >
          {MAIL_ADDRESS}
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:col-span-8">
        {
          columns.map((column) => (
            <div>
              <h2 class="label">{column.title}</h2>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-muted hover:text-accent">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <h2 class="label">Elsewhere</h2>
          <ul class="mt-4 space-y-2.5">
            {
              elsewhere.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.icon === "mail" ? undefined : "_blank"}
                    rel={link.icon === "mail" ? undefined : "noopener"}
                    class="group inline-flex items-center gap-2 text-sm text-muted hover:text-accent"
                  >
                    <span class="text-faint group-hover:text-accent">
                      {link.icon === "github" ? (
                        <Github class="size-3.5" />
                      ) : link.icon === "linkedin" ? (
                        <Linkedin class="size-3.5" />
                      ) : link.icon === "x" ? (
                        <X class="size-3.5" />
                      ) : (
                        <Icon name="mail" class="size-3.5" />
                      )}
                    </span>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="label">© {year} Shivang Rathore</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        {/* Only where a rate is on the page. The rest of the site no longer
            sells anything, and a pricing toggle there reads as a price list. */}
        {
          freelance && (
            <div class="flex items-center gap-2.5">
              <span class="label">Pricing</span>
              <RegionToggle />
            </div>
          )
        }
        <p class="label text-accent">{AVAILABILITY}</p>
      </div>
    </div>
  </div>
</footer>
