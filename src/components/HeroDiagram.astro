---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/*
  The pitch, drawn and running: whatever the clients are, they hit one Go
  service over one database, with workers off to the side. Requests travel the
  wires, the API pulses as each lands, and a response chip comes back. Kept
  generic on purpose, so it describes the work rather than one client's
  product.

  The motion is SVG <animateMotion> along the same paths that are stroked, so
  a dot can never drift off its wire and no JS runs to keep them in sync.
*/
const clients = [
  { id: "web", label: "Web", x: 4, begin: "0s" },
  { id: "mobile", label: "Mobile", x: 140, begin: "1.1s" },
  { id: "admin", label: "Admin", x: 276, begin: "2.2s" },
];

const wire = (x: number) =>
  `M ${x + 60} 62 L ${x + 60} 96 Q ${x + 60} 112 200 112 L 200 146`;

// Responses. Three fixed pairs cycling, rather than random numbers: a figure
// that changes every second reads as a toy, not as traffic.
const responses = ["200 OK · 14 ms", "200 OK · 9 ms", "201 · 22 ms"];
---

<div class:list={["relative", className]}>
  <svg
    viewBox="0 0 400 336"
    fill="none"
    class="w-full overflow-visible"
    role="img"
    aria-label="Web, mobile and admin clients sending requests to one Go API, which reads and writes a PostgreSQL database and hands work to background workers."
  >
    <!-- Wires, drawn first so the boxes sit on top of them -->
    {
      clients.map((client) => (
        <path
          id={`wire-${client.id}`}
          d={wire(client.x)}
          class="stroke-line"
          stroke-width="1"
        />
      ))
    }
    <path id="wire-db" d="M 200 214 L 200 250" class="stroke-line" stroke-width="1" />
    <path id="wire-workers" d="M 282 180 L 300 180" class="stroke-line" stroke-width="1" />

    <!-- Requests in flight -->
    {
      clients.map((client) => (
        <circle r="3.5" class="fill-accent">
          <animateMotion dur="1.5s" begin={client.begin} repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
            <mpath href={`#wire-${client.id}`} />
          </animateMotion>
          <animate
            attributeName="opacity"
            values="0;1;1;0"
            keyTimes="0;0.12;0.82;1"
            dur="1.5s"
            begin={client.begin}
            repeatCount="indefinite"
          />
        </circle>
      ))
    }

    <!-- The write that follows, on to the database -->
    <circle r="3" class="fill-accent">
      <animateMotion dur="0.9s" begin="1.4s" repeatCount="indefinite">
        <mpath href="#wire-db" />
      </animateMotion>
      <animate
        attributeName="opacity"
        values="0;1;1;0"
        keyTimes="0;0.15;0.8;1"
        dur="0.9s"
        begin="1.4s"
        repeatCount="indefinite"
      />
    </circle>

    <!-- The job handed off to the workers, after the request lands -->
    <circle r="2.5" class="fill-accent">
      <animateMotion dur="0.7s" begin="1.75s" repeatCount="indefinite">
        <mpath href="#wire-workers" />
      </animateMotion>
      <animate
        attributeName="opacity"
        values="0;1;1;0"
        keyTimes="0;0.2;0.75;1"
        dur="0.7s"
        begin="1.75s"
        repeatCount="indefinite"
      />
    </circle>

    <!-- Product front-ends -->
    {
      clients.map((client) => (
        <>
          <rect
            x={client.x}
            y="18"
            width="120"
            height="44"
            rx="4"
            class="fill-bg stroke-border"
            stroke-width="1"
          />
          <text
            x={client.x + 60}
            y="45"
            text-anchor="middle"
            class="fill-fg font-mono text-[13px]"
          >
            {client.label}
          </text>
        </>
      ))
    }

    <!-- The backend. The ring pulses as each request lands. -->
    <rect
      x="118"
      y="144"
      width="164"
      height="72"
      rx="5"
      class="ring stroke-accent"
      stroke-width="1"
      fill="none"
    />
    <rect
      x="120"
      y="146"
      width="160"
      height="68"
      rx="4"
      class="fill-bg stroke-accent"
      stroke-width="1.5"
    />
    <text
      x="200"
      y="176"
      text-anchor="middle"
      class="fill-fg font-mono text-[15px] font-semibold"
    >
      Go API
    </text>
    <text
      x="200"
      y="196"
      text-anchor="middle"
      class="fill-faint font-mono text-[11px]"
    >
      one service
    </text>

    <!-- The database -->
    <rect
      x="120"
      y="250"
      width="160"
      height="68"
      rx="4"
      class="fill-bg stroke-border"
      stroke-width="1"
    />
    <text
      x="200"
      y="280"
      text-anchor="middle"
      class="fill-fg font-mono text-[15px] font-semibold"
    >
      PostgreSQL
    </text>
    <text
      x="200"
      y="300"
      text-anchor="middle"
      class="fill-faint font-mono text-[11px]"
    >
      one source of truth
    </text>

    <!-- Background workers, off to the side so the shape is not a plain column -->
    <rect
      x="300"
      y="160"
      width="96"
      height="40"
      rx="4"
      class="fill-bg stroke-border"
      stroke-width="1"
    />
    <text
      x="348"
      y="185"
      text-anchor="middle"
      class="fill-muted font-mono text-[12px]"
    >
      Workers
    </text>

    <!-- Responses, cycling one at a time beside the API -->
    {
      responses.map((response, i) => (
        <text
          x="290"
          y="132"
          class="chip fill-accent font-mono text-[11px]"
          style={`animation-delay: ${i * 1.1}s`}
        >
          {response}
        </text>
      ))
    }
  </svg>
</div>

<style>
  .ring {
    transform-origin: 200px 180px;
    animation: land 1.1s ease-out infinite;
  }

  /* Each chip is visible for its third of the cycle, so they never overlap. */
  .chip {
    opacity: 0;
    animation: chip 3.3s ease-out infinite;
  }

  @keyframes land {
    0%,
    55%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
    12% {
      opacity: 0.55;
      transform: scale(1.02);
    }
  }

  @keyframes chip {
    0% {
      opacity: 0;
      transform: translateY(4px);
    }
    8%,
    26% {
      opacity: 1;
      transform: none;
    }
    36%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  /*
    Motion off means off: SMIL keeps running under a CSS media query, so the
    dots are hidden outright rather than left spinning invisibly.
  */
  @media (prefers-reduced-motion: reduce) {
    .ring,
    .chip {
      animation: none;
      opacity: 0;
    }

    circle {
      display: none;
    }
  }
</style>
