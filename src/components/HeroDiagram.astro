---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/*
  The pitch, drawn and running: clients hit a gateway, the gateway hits one Go
  service, the service checks a cache, writes one database, and hands the slow
  work to a queue that workers drain out to the world. Generic on purpose, so
  it describes the work rather than one client's product.

  Everything lives inside a 12px inset of the viewBox, so no node is clipped by
  the container, and only the Go API carries a second line. Nine boxes with a
  caption each was more text than the panel could hold.

  Timing is one shared cycle. Every dot animates for the full cycle and only
  moves during its own slice (keyPoints parks it at either end), so the whole
  thing reads as a single request making its way through the system rather
  than several loops drifting out of phase.
*/
const CYCLE = "4s";

/** A dot's slice of the shared cycle, as fractions from 0 to 1. */
function slice(from: number, to: number) {
  const eps = 0.004;
  return {
    keyPoints: "0;0;1;1",
    keyTimes: `0;${from};${to};1`,
    fadeValues: "0;0;1;1;0;0",
    fadeTimes: `0;${Math.max(from - eps, 0)};${from};${to};${Math.min(to + eps, 1)};1`,
  };
}

/*
  Clients take turns rather than firing together. Their dots run on a 12s
  super-cycle, one client per 4s pass, so each pass is a request from a
  different front-end and the top of the diagram is never three dots abreast.
  The sending box lights up as its request leaves, which is what makes the
  turn readable without giving each client its own colour and breaking the
  one-accent rule the rest of the site keeps to.
*/
const SUPER_CYCLE = "12s";

/** The client leg of pass `k`, expressed against the 12s super-cycle. */
const pass = (k: number) => slice((k * 4 + 0.08) / 12, (k * 4 + 0.72) / 12);

const clients = [
  { id: "web", label: "Web", x: 12, timing: pass(0), delay: "0s" },
  { id: "mobile", label: "Mobile", x: 150, timing: pass(1), delay: "4s" },
  { id: "admin", label: "Admin", x: 288, timing: pass(2), delay: "8s" },
];

/** Client box down to the gateway, as a squared elbow through a shared bus. */
const clientWire = (x: number) => `M ${x + 60} 46 V 64 H 210 V 82`;

// Everything downstream, in the order one request touches it.
const hops = [
  { id: "gateway-api", d: "M 210 122 V 158", timing: slice(0.28, 0.4) },
  // Lookup out, hit back, on separate lanes so both stay legible.
  { id: "api-cache", d: "M 110 176 H 96", timing: slice(0.42, 0.5) },
  { id: "cache-api", d: "M 96 194 H 110", timing: slice(0.5, 0.58) },
  { id: "api-db", d: "M 210 216 V 258", timing: slice(0.58, 0.72) },
  { id: "api-queue", d: "M 310 176 H 324", timing: slice(0.6, 0.68) },
  { id: "queue-workers", d: "M 367 194 V 222", timing: slice(0.68, 0.78) },
  { id: "workers-out", d: "M 367 258 V 286", timing: slice(0.8, 0.92) },
];

// Fixed pairs cycling, not random numbers: a figure that rerolls every second
// reads as a toy rather than as traffic.
const responses = ["200 OK · 14 ms", "200 OK · 9 ms", "201 · 22 ms"];

const boxes = [
  { x: 130, y: 82, w: 160, h: 40, label: "Gateway" },
  { x: 12, y: 158, w: 84, h: 36, label: "Redis" },
  { x: 324, y: 158, w: 84, h: 36, label: "Queue" },
  { x: 324, y: 222, w: 84, h: 36, label: "Workers" },
  { x: 324, y: 286, w: 84, h: 34, label: "Webhooks", quiet: true },
  { x: 110, y: 258, w: 200, h: 44, label: "PostgreSQL" },
];
---

<div class:list={["relative", className]}>
  <svg
    viewBox="0 0 420 332"
    fill="none"
    class="w-full"
    role="img"
    aria-label="Web, mobile and admin clients calling a gateway, which passes requests to one Go API. The API reads a Redis cache, writes a PostgreSQL database, and pushes background jobs onto a queue that workers drain out to webhooks."
  >
    <!-- Wires first, so every box sits on top of them -->
    {
      clients.map((client) => (
        <path
          id={`wire-${client.id}`}
          d={clientWire(client.x)}
          class="stroke-line"
          stroke-width="1"
        />
      ))
    }
    {
      hops.map((hop) => (
        <path id={`wire-${hop.id}`} d={hop.d} class="stroke-line" stroke-width="1" />
      ))
    }

    <!-- One request, followed the whole way through -->
    {
      [
        ...clients.map((c) => ({ ...c, dur: SUPER_CYCLE })),
        ...hops.map((h) => ({ ...h, dur: CYCLE })),
      ].map((step) => (
        <circle r={step.id === "cache-api" ? 2.5 : 3} class="fill-accent">
          <animateMotion
            dur={step.dur}
            repeatCount="indefinite"
            calcMode="linear"
            keyPoints={step.timing.keyPoints}
            keyTimes={step.timing.keyTimes}
          >
            <mpath href={`#wire-${step.id}`} />
          </animateMotion>
          <animate
            attributeName="opacity"
            dur={step.dur}
            repeatCount="indefinite"
            values={step.timing.fadeValues}
            keyTimes={step.timing.fadeTimes}
          />
        </circle>
      ))
    }

    <!-- Clients -->
    {
      clients.map((client) => (
        <>
          <rect
            x={client.x}
            y="10"
            width="120"
            height="36"
            rx="4"
            class="sender fill-bg stroke-border"
            stroke-width="1"
            style={`animation-delay: ${client.delay}`}
          />
          <text
            x={client.x + 60}
            y="33"
            text-anchor="middle"
            class="fill-fg font-mono text-[13px]"
          >
            {client.label}
          </text>
        </>
      ))
    }

    <!-- Supporting infrastructure -->
    {
      boxes.map((box) => (
        <>
          <rect
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            rx="4"
            class="fill-bg stroke-border"
            stroke-width="1"
          />
          <text
            x={box.x + box.w / 2}
            y={box.y + box.h / 2 + 4}
            text-anchor="middle"
            class:list={[
              "font-mono text-[12px]",
              box.quiet ? "fill-muted" : "fill-fg",
            ]}
          >
            {box.label}
          </text>
        </>
      ))
    }

    <!-- The service itself. The ring pulses as the request lands. -->
    <rect
      x="108"
      y="156"
      width="204"
      height="62"
      rx="5"
      class="ring stroke-accent"
      stroke-width="1"
      fill="none"
    />
    <rect
      x="110"
      y="158"
      width="200"
      height="58"
      rx="4"
      class="fill-bg stroke-accent"
      stroke-width="1.5"
    />
    <text
      x="210"
      y="184"
      text-anchor="middle"
      class="fill-fg font-mono text-[15px] font-semibold"
    >
      Go API
    </text>
    <text
      x="210"
      y="202"
      text-anchor="middle"
      class="fill-faint font-mono text-[10px]"
    >
      one service
    </text>

    <!-- Responses, one at a time, landing at the end of each cycle -->
    {
      responses.map((response, i) => (
        <text
          x="306"
          y="148"
          text-anchor="end"
          class="chip fill-accent font-mono text-[11px]"
          style={`animation-delay: ${i * 4}s`}
        >
          {response}
        </text>
      ))
    }
  </svg>
</div>

<style>
  .ring {
    transform-origin: 210px 187px;
    animation: land 4s ease-out infinite;
  }

  /* Each client border turns accent for the half second its request is on the
     wire, then hands the turn to the next one. */
  .sender {
    animation: sending 12s linear infinite;
  }

  @keyframes sending {
    0%,
    7% {
      stroke: var(--color-accent);
    }
    9%,
    100% {
      stroke: var(--color-border);
    }
  }

  /* Three chips share a 12s loop, each visible near the end of its own 4s
     cycle, so a response always follows the request that earned it. */
  .chip {
    opacity: 0;
    animation: chip 12s ease-out infinite;
  }

  @keyframes land {
    0%,
    46%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
    40% {
      opacity: 0.5;
      transform: scale(1.015);
    }
  }

  @keyframes chip {
    0%,
    20% {
      opacity: 0;
      transform: translateY(4px);
    }
    24%,
    30% {
      opacity: 1;
      transform: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  /*
    Motion off means off: SMIL keeps running regardless of a CSS media query,
    so the dots are hidden outright rather than left moving invisibly.
  */
  @media (prefers-reduced-motion: reduce) {
    .ring,
    .chip {
      animation: none;
      opacity: 0;
    }

    .sender {
      animation: none;
    }

    circle {
      display: none;
    }
  }
</style>
