---
import type { Experience } from "@/lib/experience";

interface Props {
  items: Experience[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<!--
  Period on the left, role on the right, a hairline between entries. The old
  dotted vertical line spent horizontal space on decoration; the date column
  earns it by being scannable.
-->
<ol class:list={["divide-y divide-line border-t border-line", className]}>
  {
    items.map((job) => (
      <li class="grid gap-x-6 gap-y-2 py-7 lg:grid-cols-[10.5rem_1fr]">
        {/* Dates keep mono for alignment but drop the wide label tracking:
            at 0.18em a period like "Jul 2025 - Present" wraps in this column. */}
        <div class="pt-1.5 font-mono text-xs leading-relaxed text-faint">
          <p class="text-pretty">{job.period}</p>
          {job.location && <p class="mt-1">{job.location}</p>}
        </div>

        <div class="min-w-0">
          <h3 class="flex flex-wrap items-center gap-x-2 gap-y-1.5 font-semibold tracking-tight text-fg">
            <span>
              {job.role}
              <span class="font-normal text-muted">
                {" at "}
                {job.companyUrl ? (
                  <a
                    href={job.companyUrl}
                    target="_blank"
                    rel="noopener"
                    class="underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent"
                  >
                    {job.company}
                  </a>
                ) : (
                  job.company
                )}
              </span>
            </span>
            {job.engagement && (
              <span class="label border border-line px-2 py-1 text-faint">
                {job.engagement}
              </span>
            )}
            {job.current && (
              <span class="label inline-flex items-center gap-1.5 border border-accent/40 px-2 py-1 text-accent">
                <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                Current
              </span>
            )}
          </h3>

          <p class="measure mt-2.5 text-sm leading-relaxed text-muted">
            {job.summary}
          </p>

          {job.highlights && job.highlights.length > 0 && (
            <ul class="measure mt-4 space-y-2">
              {job.highlights.map((item) => (
                <li class="relative pl-4 text-sm leading-relaxed text-muted">
                  <span
                    class="absolute left-0 top-[0.62rem] h-px w-2 bg-border"
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))}
            </ul>
          )}

          {job.stack && job.stack.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 font-mono text-xs text-faint">
              {job.stack.map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>
