---
import type { Experience } from "@/lib/experience";

interface Props {
  items: Experience[];
}

const { items } = Astro.props;
---

<ol class="relative mt-6 border-l border-border">
  {
    items.map((job) => (
      <li class="relative pb-9 pl-7 last:pb-0">
        <span
          class:list={[
            "absolute -left-[5.5px] top-1.5 size-2.5 rounded-full ring-4 ring-bg",
            job.current ? "bg-accent" : "bg-border",
          ]}
          aria-hidden="true"
        />
        <p class="font-mono text-xs text-faint">
          {job.period}
          {job.location && <span> · {job.location}</span>}
        </p>
        <h3 class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 font-medium text-fg">
          <span>
            {job.role}
            <span class="text-muted">
              {" · "}
              {job.companyUrl ? (
                <a
                  href={job.companyUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent"
                >
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </span>
          </span>
          {job.engagement && (
            <span class="rounded-full border border-border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-muted">
              {job.engagement}
            </span>
          )}
          {job.current && (
            <span class="rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-accent">
              Current
            </span>
          )}
        </h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">{job.summary}</p>
        {job.highlights && job.highlights.length > 0 && (
          <ul class="mt-3 space-y-1.5">
            {job.highlights.map((item) => (
              <li class="relative pl-4 text-sm leading-relaxed text-muted">
                <span
                  class="absolute left-0 top-[0.6rem] size-1 rounded-full bg-border"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))}
          </ul>
        )}
        {job.stack && job.stack.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {job.stack.map((tech) => (
              <span class="rounded-md bg-surface px-2 py-0.5 font-mono text-xs text-faint">
                {tech}
              </span>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>
