---
import { getCollection, type CollectionEntry } from "astro:content";
import Github from "@/components/icons/Github.astro";
import Icon from "@/components/icons/Icon.astro";
import { toTitleCase } from "@/lib/utils";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const p = project.data;

// A project can point at a case study that is still a draft, and drafts are not
// built in production. Only link when the target page will actually exist.
const studies = await getCollection("caseStudies");
const caseStudy =
  p.caseStudy &&
  studies.some(
    (s) => s.id === p.caseStudy && (import.meta.env.DEV || !s.data.draft),
  )
    ? p.caseStudy
    : undefined;

// Long stack lists took more vertical space on the card than the description of
// what the thing does, which put the tech ahead of the outcome.
const TECH_LIMIT = 5;
const shownTech = p.technologies.slice(0, TECH_LIMIT);
const hiddenTech = p.technologies.length - shownTech.length;
---

<article
  class="group flex h-full flex-col rounded-xl border border-border bg-surface/40 p-5 transition-colors hover:border-accent/50"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-fg">
      {
        caseStudy ? (
          <a href={`/case-studies/${caseStudy}`} class="hover:text-accent">
            {p.title}
          </a>
        ) : (
          p.title
        )
      }
    </h3>
    <div class="flex shrink-0 items-center gap-2 text-faint">
      {
        p.github && (
          <a href={p.github} target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-fg">
            <Github class="size-4" />
          </a>
        )
      }
      {
        p.demo && (
          <a href={p.demo} target="_blank" rel="noopener" aria-label="Live demo" class="hover:text-fg">
            <Icon name="arrow-up-right" class="size-4" />
          </a>
        )
      }
    </div>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      shownTech.map((tech) => (
        <span class="rounded-md bg-surface px-2 py-0.5 font-mono text-xs text-faint">
          {tech}
        </span>
      ))
    }
    {
      hiddenTech > 0 && (
        <span class="rounded-md px-2 py-0.5 font-mono text-xs text-faint">
          +{hiddenTech} more
        </span>
      )
    }
  </div>

  <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 text-xs text-faint">
    <span>{p.date}</span>
    <span class="inline-flex items-center gap-3">
      {
        caseStudy && (
          <a href={`/case-studies/${caseStudy}`} class="inline-flex items-center gap-1 text-accent hover:underline">
            Case study
            <Icon name="arrow-right" class="size-3" />
          </a>
        )
      }
      <span class="rounded-full border border-border px-2 py-0.5">
        {toTitleCase(p.status)}
      </span>
    </span>
  </div>
</article>
