---
import Button from "@/components/Button.astro";
import Icon from "@/components/icons/Icon.astro";
import { BOOKING_URL, BOOKING_LENGTH, AVAILABILITY } from "@/lib/constants";

interface Props {
  /** Overrides for pages that need a more specific ask. */
  heading?: string;
  body?: string;
  class?: string;
}

// The booking link only renders once it exists, so the primary CTA is never
// dead, and the heading never promises a call the buttons cannot deliver.
const booking = BOOKING_URL.length > 0;

const {
  heading = booking
    ? `Most projects start with a ${BOOKING_LENGTH} call`
    : "Tell me what you are building",
  body = "Send the problem, the deadline and roughly what the budget looks like. You get an honest read on whether I am the right person, a rough timeline, and a price range. If I am not a fit I will say so and point you somewhere better.",
  class: className,
} = Astro.props;
---

<!--
  The closing band. Accent rule on top instead of a bordered box: it reads as
  the end of the page rather than one more card stacked on the others.
-->
<section class:list={["reveal border-t-2 border-accent bg-surface", className]}>
  <div class="shell grid gap-x-12 gap-y-8 py-16 md:py-20 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 class="text-title text-balance">{heading}</h2>
      <p class="measure mt-5 leading-relaxed text-muted">{body}</p>
    </div>

    <div class="lg:col-span-5 lg:pt-2">
      <div class="flex flex-wrap items-center gap-3">
        {
          booking ? (
            <>
              <Button
                variant="primary"
                href={BOOKING_URL}
                target="_blank"
                rel="noopener"
                data-track="book-call"
              >
                <Icon name="calendar" class="size-4" />
                Book a {BOOKING_LENGTH} call
              </Button>
              <Button href="/contact">Send details instead</Button>
            </>
          ) : (
            <>
              <Button variant="primary" href="/contact">
                Start a project
                <Icon name="arrow-right" class="size-4" />
              </Button>
              <Button href="/services">What I build</Button>
            </>
          )
        }
      </div>

      <dl class="mt-8 space-y-3 border-t border-line pt-6">
        <div class="flex gap-4">
          <dt class="label w-24 shrink-0 pt-0.5">Status</dt>
          <dd class="text-sm text-fg">{AVAILABILITY}</dd>
        </div>
        <div class="flex gap-4">
          <dt class="label w-24 shrink-0 pt-0.5">Reply</dt>
          <dd class="text-sm text-fg">Within 24 hours</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
