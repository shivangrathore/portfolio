---
import { NAV_ITEMS, GITHUB_URL, LINKEDIN_URL } from "@/lib/constants";
import { cn } from "@/lib/utils";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import Icon from "@/components/icons/Icon.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5">
    <a href="/" class="font-mono text-sm font-medium text-fg">
      shivang<span class="text-accent">.</span>
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-1 md:flex">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class={cn(
              "rounded-md px-3 py-1.5 text-sm transition-colors",
              isActive(item.href)
                ? "text-accent"
                : "text-muted hover:text-fg",
            )}
          >
            {item.name}
          </a>
        ))
      }
      <span class="mx-2 h-4 w-px bg-border"></span>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="p-1.5 text-muted hover:text-fg"
      >
        <Github class="size-4" />
      </a>
      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        class="p-1.5 text-muted hover:text-fg"
      >
        <Linkedin class="size-4" />
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      class="p-1.5 text-muted hover:text-fg md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="menu" class="size-5" id="nav-icon-menu" />
      <Icon name="x" class="hidden size-5" id="nav-icon-x" />
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="nav-menu" class="hidden border-t border-border/60 md:hidden">
    <div class="mx-auto flex max-w-3xl flex-col px-5 py-3">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class={cn(
              "rounded-md px-2 py-2.5 text-sm",
              isActive(item.href) ? "text-accent" : "text-muted",
            )}
          >
            {item.name}
          </a>
        ))
      }
      <div class="mt-2 flex gap-4 border-t border-border/60 pt-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub" class="text-muted">
          <Github class="size-5" />
        </a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-muted">
          <Linkedin class="size-5" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconMenu = document.getElementById("nav-icon-menu");
  const iconX = document.getElementById("nav-icon-x");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    iconMenu?.classList.toggle("hidden", open);
    iconX?.classList.toggle("hidden", !open);
  });
</script>
