---
import { NAV_ITEMS, GITHUB_URL, LINKEDIN_URL } from "@/lib/constants";
import { cn } from "@/lib/utils";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import Icon from "@/components/icons/Icon.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="text-sm font-semibold tracking-tight text-fg hover:text-accent"
    >
      Shivang Rathore<span class="text-accent">.</span>
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-7 md:flex">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              // The active marker is a rule under the word, not a filled pill:
              // same language as every other divider on the page.
              "relative py-1 text-sm transition-colors after:absolute after:inset-x-0 after:-bottom-px after:h-px after:transition-colors",
              isActive(item.href)
                ? "text-fg after:bg-accent"
                : "text-muted after:bg-transparent hover:text-fg hover:after:bg-line",
            )}
          >
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-2 md:flex">
      <ThemeToggle />
      <a
        href="/contact"
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90"
      >
        Start a project
      </a>
    </div>

    <!-- Mobile -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        id="nav-toggle"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted hover:bg-surface hover:text-fg"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <Icon name="menu" class="size-5" id="nav-icon-menu" />
        <Icon name="x" class="hidden size-5" id="nav-icon-x" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="nav-menu" class="hidden border-t border-line md:hidden">
    <div class="shell flex flex-col py-3">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={cn(
              "border-l-2 py-2.5 pl-3 text-sm",
              isActive(item.href)
                ? "border-accent text-fg"
                : "border-transparent text-muted",
            )}
          >
            {item.name}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mt-3 rounded-md bg-accent px-4 py-2.5 text-center text-sm font-medium text-accent-fg"
      >
        Start a project
      </a>
      <div class="mt-4 flex gap-4 border-t border-line pt-4">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="text-muted hover:text-accent"
        >
          <Github class="size-5" />
        </a>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="text-muted hover:text-accent"
        >
          <Linkedin class="size-5" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconMenu = document.getElementById("nav-icon-menu");
  const iconX = document.getElementById("nav-icon-x");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    iconMenu?.classList.toggle("hidden", open);
    iconX?.classList.toggle("hidden", !open);
  });
</script>
