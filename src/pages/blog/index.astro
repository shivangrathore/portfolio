---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Cta from "@/components/Cta.astro";
import { abs, breadcrumbs } from "@/lib/schema";

const isDev = import.meta.env.DEV;
let posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
if (!isDev) posts = posts.filter((p) => !p.data.draft);

const schema = [
  breadcrumbs([{ name: "Blog", path: "/blog" }]),
  {
    "@type": "Blog",
    "@id": `${abs("/blog/")}#blog`,
    name: "Blog",
    description:
      "Thoughts on web development, system programming, Linux, Go, and Rust.",
    url: abs("/blog/"),
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      "@id": `${abs(`/blog/${post.id}/`)}#article`,
      headline: post.data.title,
      description: post.data.description,
      url: abs(`/blog/${post.id}/`),
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
];
---

<Base
  title="Blog"
  description="Thoughts on web development, system programming, Linux, Go, and Rust."
  schema={schema}
>
  <PageHeader
    label="Blog"
    title="Notes on backends that have to hold up"
    lede="Auth, permissions, multi-tenancy and systems work, written from things that shipped rather than things I read about."
  />

  <div class="shell py-14 md:py-16">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet. Check back soon.</p>
      ) : (
        <div class="border-b border-line">
          {posts.map((post) => (
            <PostRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
            />
          ))}
        </div>
      )
    }
  </div>

  <Cta />
</Base>
