---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/icons/Icon.astro";
import Button from "@/components/Button.astro";
import Cta from "@/components/Cta.astro";
import { landings } from "@/lib/landings";
import { abs, breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return landings.map((landing) => ({
    params: { slug: landing.slug },
    props: { landing },
  }));
}

const { landing } = Astro.props;
const path = `/hire/${landing.slug}/`;

const schema = [
  breadcrumbs([
    { name: "Hire", path: "/hire" },
    { name: landing.eyebrow, path },
  ]),
  {
    "@type": "Service",
    "@id": `${abs(path)}#service`,
    name: landing.heading,
    url: abs(path),
    description: landing.metaDescription,
    serviceType: landing.eyebrow,
    provider: { "@id": `${abs("/")}#person` },
    areaServed: "Worldwide",
    availableLanguage: "English",
  },
  {
    "@type": "FAQPage",
    "@id": `${abs(path)}#faq`,
    mainEntity: landing.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title={landing.metaTitle}
  description={landing.metaDescription}
  schema={schema}
>
  <PageHeader
    label={`${landing.eyebrow} · taking new projects`}
    title={landing.heading}
    lede={landing.intro}
  >
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <Button variant="primary" href="/contact">
        Start a project
        <Icon
          name="arrow-right"
          class="size-4 transition-transform group-hover/btn:translate-x-0.5"
        />
      </Button>
      <Button href="/services">Everything I build</Button>
    </div>
    <p class="mt-4 text-sm text-faint">
      No obligation. I reply to every enquiry within 24 hours.
    </p>
  </PageHeader>

  <Section index="01" title="What you get" seamless>
    <div class="border-t border-line">
      {
        landing.offer.map((item) => (
          <article class="border-b border-line py-6">
            <h3 class="flex items-start gap-2.5 font-semibold tracking-tight text-fg">
              <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
              <span>{item.name}</span>
            </h3>
            <p class="measure mt-2 pl-[26px] text-sm leading-relaxed text-muted">
              {item.detail}
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section index="02" title="Where I have done this">
    <div class="border-t border-line">
      {
        landing.proof.map((item) => (
          <div class="border-b border-line py-6">
            <h3 class="font-semibold tracking-tight text-fg">{item.name}</h3>
            <p class="measure mt-2 text-sm leading-relaxed text-muted">
              {item.detail}
            </p>
            {item.href && (
              <a
                href={item.href}
                class="group mt-3 inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent"
              >
                Read more
                <Icon
                  name="arrow-right"
                  class="size-3.5 transition-transform group-hover:translate-x-0.5"
                />
              </a>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    index="03"
    title="Whether this is a fit"
    lede="Saying no early costs us both less than finding out six weeks in."
  >
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      <div class="border-t-2 border-accent pt-5">
        <h3 class="label text-accent">Right call when</h3>
        <ul class="mt-4 grid gap-3">
          {
            landing.fit.good.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="border-t-2 border-border pt-5">
        <h3 class="label">Not me</h3>
        <ul class="mt-4 grid gap-3">
          {
            landing.fit.bad.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <Icon name="x" class="mt-0.5 size-4 shrink-0 text-faint" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section index="04" title="Common questions">
    <Faq items={landing.faqs} />

    <div class="mt-10 border-t border-line pt-6">
      <h3 class="label">Keep reading</h3>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5 text-sm">
        {
          landing.related.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-muted underline decoration-line underline-offset-4 hover:text-accent hover:decoration-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Cta />
</Base>
