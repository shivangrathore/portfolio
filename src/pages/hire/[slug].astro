---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/icons/Icon.astro";
import Button from "@/components/Button.astro";
import Cta from "@/components/Cta.astro";
import { landings } from "@/lib/landings";
import { abs, breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return landings.map((landing) => ({
    params: { slug: landing.slug },
    props: { landing },
  }));
}

const { landing } = Astro.props;
const path = `/hire/${landing.slug}/`;

const schema = [
  breadcrumbs([
    { name: "Hire", path: "/hire" },
    { name: landing.eyebrow, path },
  ]),
  {
    "@type": "Service",
    "@id": `${abs(path)}#service`,
    name: landing.heading,
    url: abs(path),
    description: landing.metaDescription,
    serviceType: landing.eyebrow,
    provider: { "@id": `${abs("/")}#person` },
    areaServed: "Worldwide",
    availableLanguage: "English",
  },
  {
    "@type": "FAQPage",
    "@id": `${abs(path)}#faq`,
    mainEntity: landing.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title={landing.metaTitle}
  description={landing.metaDescription}
  schema={schema}
>
  <!-- Header -->
  <section class="mx-auto max-w-3xl px-5 pb-10 pt-16 md:pt-20">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/40 px-3 py-1 text-xs text-muted"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {landing.eyebrow} · taking new projects
    </span>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-balance md:text-4xl">
      {landing.heading}
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-pretty text-muted">
      {landing.intro}
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <Button variant="primary" href="/contact">
        Start a project
        <Icon name="arrow-right" class="size-4" />
      </Button>
      <Button href="/services">Everything I build</Button>
    </div>
    <p class="mt-4 text-sm text-faint">
      No obligation. I reply to every enquiry within 24 hours.
    </p>
  </section>

  <!-- What you get -->
  <section class="mx-auto max-w-3xl px-5 py-8">
    <h2 class="text-lg font-semibold tracking-tight">What you get</h2>
    <div class="mt-6 grid gap-4">
      {
        landing.offer.map((item) => (
          <article class="rounded-xl border border-border bg-surface/40 p-6">
            <h3 class="flex items-start gap-2.5 font-semibold tracking-tight">
              <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" />
              <span>{item.name}</span>
            </h3>
            <p class="mt-2 pl-[26px] text-sm leading-relaxed text-muted">
              {item.detail}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Proof -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h2 class="text-lg font-semibold tracking-tight">Where I have done this</h2>
    <div class="mt-6 grid gap-4">
      {
        landing.proof.map((item) => (
          <div class="rounded-xl border border-border bg-surface/40 p-6">
            <h3 class="font-semibold tracking-tight">{item.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
            {item.href && (
              <a
                href={item.href}
                class="mt-3 inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent"
              >
                Read more
                <Icon name="arrow-right" class="size-3.5" />
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Fit -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h2 class="text-lg font-semibold tracking-tight">Whether this is a fit</h2>
    <p class="mt-2 max-w-xl text-sm text-muted">
      Saying no early costs us both less than finding out six weeks in.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-accent/30 bg-surface/40 p-6">
        <h3 class="font-mono text-xs uppercase tracking-wider text-accent">
          Right call when
        </h3>
        <ul class="mt-4 grid gap-3">
          {
            landing.fit.good.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-surface/40 p-6">
        <h3 class="font-mono text-xs uppercase tracking-wider text-faint">
          Not me
        </h3>
        <ul class="mt-4 grid gap-3">
          {
            landing.fit.bad.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <Icon name="x" class="mt-0.5 size-4 shrink-0 text-faint" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h2 class="text-lg font-semibold tracking-tight">Common questions</h2>
    <div
      class="mt-6 divide-y divide-border/60 rounded-xl border border-border bg-surface/40"
    >
      {
        landing.faqs.map((faq) => (
          <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-fg">
              {faq.q}
              <Icon
                name="arrow-right"
                class="size-4 shrink-0 text-faint transition-transform group-open:rotate-90"
              />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Related -->
  <section class="mx-auto max-w-3xl px-5 pb-4 pt-8">
    <h2 class="text-sm font-medium uppercase tracking-wider text-faint">
      Keep reading
    </h2>
    <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5 text-sm">
      {
        landing.related.map((link) => (
          <li>
            <a href={link.href} class="text-muted hover:text-accent">
              {link.label} →
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Cta />
</Base>
