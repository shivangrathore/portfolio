---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import PostRow from "@/components/PostRow.astro";
import Cta from "@/components/Cta.astro";
import { abs, breadcrumbs } from "@/lib/schema";

const isDev = import.meta.env.DEV;
let studies = (await getCollection("caseStudies")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
if (!isDev) studies = studies.filter((s) => !s.data.draft);

const schema = [
  breadcrumbs([{ name: "Case Studies", path: "/case-studies" }]),
  {
    "@type": "CollectionPage",
    "@id": `${abs("/case-studies/")}#collection`,
    name: "Case Studies",
    url: abs("/case-studies/"),
    hasPart: studies.map((study) => ({
      "@type": "Article",
      "@id": `${abs(`/case-studies/${study.id}/`)}#article`,
      headline: study.data.title,
      description: study.data.description,
      url: abs(`/case-studies/${study.id}/`),
      datePublished: study.data.pubDate.toISOString(),
    })),
  },
];
---

<Base
  title="Case Studies"
  description="In-depth write-ups of features and projects I've built: the problem, the approach, and the trade-offs."
  schema={schema}
>
  <PageHeader
    label="Case studies"
    title="The problem, the approach, the trade-offs"
    lede="Long-form write-ups of what I built, what it had to survive, and the decisions I would defend in a review."
  />

  <div class="shell py-14 md:py-16">
    {
      studies.length === 0 ? (
        <p class="text-muted">No case studies yet. Check back soon.</p>
      ) : (
        <div class="border-b border-line">
          {studies.map((s) => (
            <PostRow
              href={`/case-studies/${s.id}`}
              title={s.data.title}
              description={s.data.description}
              pubDate={s.data.pubDate}
              facts={[s.data.role, s.data.timeline].filter(Boolean) as string[]}
              tags={s.data.tags}
            />
          ))}
        </div>
      )
    }
  </div>

  <Cta />
</Base>
