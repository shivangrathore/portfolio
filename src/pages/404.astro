---
import Base from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/icons/Icon.astro";
import { NAV_ITEMS } from "@/lib/constants";
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="shell grid gap-x-12 gap-y-10 py-24 md:py-32 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="label text-accent">Error 404</p>
      <h1 class="mt-5 text-display text-balance">This page is not here</h1>
      <p class="measure mt-6 text-lg leading-relaxed text-muted">
        The link is wrong, or the page moved. Either way, everything on the site
        is one click away on the right.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button variant="primary" href="/">
          Back home
          <Icon
            name="arrow-right"
            class="size-4 transition-transform group-hover/btn:translate-x-0.5"
          />
        </Button>
        <Button href="/contact">Start a project</Button>
      </div>
    </div>

    <nav class="lg:col-span-5">
      <p class="label">Everything else</p>
      <ul class="mt-4 border-t border-line">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex items-center justify-between border-b border-line py-3.5 text-sm text-fg transition-colors hover:bg-surface hover:text-accent"
              >
                {item.name}
                <Icon
                  name="arrow-right"
                  class="size-4 text-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>
