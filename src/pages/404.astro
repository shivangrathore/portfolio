---
import Base from "@/layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-32 text-center">
    <p class="font-mono text-5xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-2 text-muted">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-fg hover:opacity-90"
    >
      Back home
    </a>
  </div>
</Base>
