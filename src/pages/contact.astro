---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import ContactForm from "@/components/ContactForm.tsx";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import Icon from "@/components/icons/Icon.astro";
import Button from "@/components/Button.astro";
import {
  GITHUB_URL,
  LINKEDIN_URL,
  MAIL_ADDRESS,
  BOOKING_URL,
  BOOKING_LENGTH,
} from "@/lib/constants";
import { abs, breadcrumbs } from "@/lib/schema";

const methods = [
  {
    label: "Email",
    value: MAIL_ADDRESS,
    href: `mailto:${MAIL_ADDRESS}`,
    icon: "mail" as const,
  },
  {
    label: "GitHub",
    value: "github.com/shivangrathore",
    href: GITHUB_URL,
    external: true,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/shivangrathore",
    href: LINKEDIN_URL,
    external: true,
  },
];

const lookingFor = [
  "Idea to MVP builds for early startups",
  "Go backend and API work",
  "Full-stack product builds",
  "Node to Go migrations",
  "Real-time and event-driven systems",
  "Architecture reviews",
];
---

<Base
  title="Start a Project"
  description="Start a freelance project. Tell me what you are building, your deadline and budget, and get a reply within 24 hours."
  schema={[
    breadcrumbs([{ name: "Contact", path: "/contact" }]),
    {
      "@type": "ContactPage",
      "@id": `${abs("/contact/")}#contact`,
      url: abs("/contact/"),
      name: "Contact Shivang Rathore",
    },
  ]}
>
  <PageHeader
    label="Taking new projects"
    title="Start a project"
    lede="Tell me what you are building, when you need it, and roughly what the budget looks like. I reply within 24 hours, and if I am not the right person I will say so and point you somewhere better."
  />

  <div class="shell grid gap-x-12 gap-y-14 py-14 md:py-16 lg:grid-cols-12">
    <!-- Form: the wide column, because it is the thing to do on this page. -->
    <div class="lg:col-span-7">
      <h2 class="label">Project details</h2>
      <p class="mt-3 text-sm text-faint">
        The more you fill in, the more useful my first reply will be.
      </p>
      <div class="mt-7 border-t border-line pt-8">
        <ContactForm client:load />
      </div>
    </div>

    <aside class="lg:col-span-5">
      <!--
        Booking sits above the direct channels because it converts the buyers
        who are furthest along: a serious client wants a slot, not a wait for
        a reply. The form stays for everyone who would rather write it down.
      -->
      {
        BOOKING_URL && (
          <div class="border-t-2 border-accent bg-surface p-6">
            <h2 class="text-heading">Rather talk it through?</h2>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">
              Pick a {BOOKING_LENGTH} slot that suits you. No charge, no pitch,
              and you leave knowing whether this is worth doing.
            </p>
            <Button
              variant="primary"
              href={BOOKING_URL}
              target="_blank"
              rel="noopener"
              data-track="book-call"
              class="mt-5 w-full"
            >
              <Icon name="calendar" class="size-4" />
              Book a call
            </Button>
          </div>
        )
      }

      <h2 class="label mt-10">Direct</h2>
      <div class="mt-4 border-t border-line">
        {
          methods.map((m) => (
            <a
              href={m.href}
              target={m.external ? "_blank" : undefined}
              rel={m.external ? "noopener" : undefined}
              class="group flex items-center gap-3 border-b border-line py-3.5 text-sm transition-colors hover:bg-surface"
            >
              <span class="text-faint group-hover:text-accent">
                {m.label === "GitHub" ? (
                  <Github class="size-4" />
                ) : m.label === "LinkedIn" ? (
                  <Linkedin class="size-4" />
                ) : (
                  <Icon name="mail" class="size-4" />
                )}
              </span>
              <span class="text-fg group-hover:text-accent">{m.value}</span>
            </a>
          ))
        }
      </div>

      <h2 class="label mt-10">What I take on</h2>
      <ul class="mt-4 border-t border-line">
        {
          lookingFor.map((item) => (
            <li class="flex items-start gap-2.5 border-b border-line py-3 text-sm text-muted">
              <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>
