---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/ContactForm.tsx";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import Icon from "@/components/icons/Icon.astro";
import { GITHUB_URL, LINKEDIN_URL, MAIL_ADDRESS } from "@/lib/constants";

const methods = [
  {
    label: "Email",
    value: MAIL_ADDRESS,
    href: `mailto:${MAIL_ADDRESS}`,
    icon: "mail" as const,
  },
  {
    label: "GitHub",
    value: "github.com/shivangrathore",
    href: GITHUB_URL,
    external: true,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/shivangrathore",
    href: LINKEDIN_URL,
    external: true,
  },
];

const lookingFor = [
  "Full-time or contract engineering roles",
  "Open-source collaboration",
  "Freelance projects & technical advice",
];
---

<Base
  title="Contact"
  description="Get in touch about opportunities, collaboration, or a technical conversation."
>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/40 px-3 py-1 text-xs text-muted"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      Available for opportunities
    </span>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight md:text-4xl">
      Get in touch
    </h1>
    <p class="mt-3 max-w-xl text-muted">
      Interested in new opportunities, open-source collaboration, or just want
      to talk shop? Send a message below or reach out directly. I usually reply
      within 24 hours.
    </p>

    <!-- Direct channels: compact row -->
    <div class="mt-8 flex flex-wrap gap-3">
      {
        methods.map((m) => (
          <a
            href={m.href}
            target={m.external ? "_blank" : undefined}
            rel={m.external ? "noopener" : undefined}
            class="group inline-flex items-center gap-2.5 rounded-lg border border-border bg-surface/40 px-4 py-2.5 text-sm transition-colors hover:border-accent/50"
          >
            <span class="text-accent">
              {m.label === "GitHub" ? (
                <Github class="size-4" />
              ) : m.label === "LinkedIn" ? (
                <Linkedin class="size-4" />
              ) : (
                <Icon name="mail" class="size-4" />
              )}
            </span>
            <span class="text-fg group-hover:text-accent">{m.value}</span>
          </a>
        ))
      }
    </div>

    <!-- Form: full width -->
    <div class="mt-8 rounded-xl border border-border bg-surface/40 p-6 sm:p-8">
      <h2 class="text-lg font-semibold tracking-tight">Send a message</h2>
      <p class="mt-1 text-sm text-faint">
        Fill this out and it lands straight in my inbox.
      </p>
      <div class="mt-6">
        <ContactForm client:load />
      </div>
    </div>

    <!-- What I'm looking for -->
    <div class="mt-10">
      <h2 class="text-sm font-medium uppercase tracking-wider text-faint">
        What I'm looking for
      </h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5 text-sm text-muted">
        {
          lookingFor.map((item) => (
            <li class="flex items-center gap-2.5">
              <span class="size-1.5 shrink-0 rounded-full bg-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
