---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import Portrait from "@/components/Portrait.astro";
import Timeline from "@/components/Timeline.astro";
import Button from "@/components/Button.astro";
import Cta from "@/components/Cta.astro";
import Icon from "@/components/icons/Icon.astro";
import { experience } from "@/lib/experience";
import { MAIL_ADDRESS, RESUME_URL } from "@/lib/constants";
import { abs, breadcrumbs } from "@/lib/schema";

// Kept in step with the resume's skills section: only what shows up in shipped
// work and holds up in an interview. A recruiter reads both.
const skills: { group: string; items: string[] }[] = [
  { group: "Languages", items: ["TypeScript", "JavaScript", "Go", "Python", "SQL"] },
  { group: "Frontend", items: ["React", "Next.js", "TanStack Query", "Tailwind CSS", "PWAs", "i18n"] },
  { group: "Backend", items: ["Node.js", "Express", "Gin", "gRPC", "Protocol Buffers", "WebSockets"] },
  { group: "Data", items: ["PostgreSQL", "Redis", "RabbitMQ", "MongoDB"] },
  {
    group: "Infra",
    items: ["Docker", "Docker Compose", "Coolify", "Linux", "GitHub Actions", "AWS S3", "Turborepo", "Vercel"],
  },
  {
    group: "Integrations",
    items: [
      "Stripe",
      "WebAuthn (passkeys)",
      "Firebase Cloud Messaging",
      "Gotenberg",
      "OpenAI",
      "Twilio",
      "Google OAuth",
      "discord.py",
    ],
  },
  { group: "Tools", items: ["sqlc", "pgx", "Zod"] },
];

const education = {
  school: "LNCT University, Bhopal",
  degree: "Bachelor of Computer Applications (BCA)",
  period: "2021 - 2024",
  location: "Bhopal, Madhya Pradesh, India",
};
---

<Base
  title="About"
  description="Full stack engineer in India, building software since 2019: TypeScript and React, Go, Python and PostgreSQL. Contract engineer on a UK fleet-compliance platform and founder of Finalist."
  schema={[
    breadcrumbs([{ name: "About", path: "/about" }]),
    {
      "@type": "ProfilePage",
      "@id": `${abs("/about/")}#profile`,
      url: abs("/about/"),
      name: "About Shivang Rathore",
      mainEntity: { "@id": `${abs("/")}#person` },
    },
  ]}
>
  <PageHeader
    label="About"
    title="Full stack engineer, building since 2019"
    lede="TypeScript and React on the front, Go, Python and PostgreSQL behind it. A UK fleet-compliance platform by day, and an esports platform I founded on the side."
  >
    <!-- Reads from src/assets/portrait.*; the header closes up if it is removed. -->
    <Portrait
      slot="aside"
      class="aspect-3/4 w-full max-w-sm lg:mt-2 lg:max-w-none"
      sizes="(min-width: 1024px) 22rem, 24rem"
    />
  </PageHeader>

  <Section standfirst="Who you would work with" title="Background" seamless>
    <div class="prose">
      <p>
        I'm a full stack engineer, and I have been building software since
        2019. My strongest ground is <strong>TypeScript</strong> and
        <strong>React/Next.js</strong>; behind it I work in <strong>Go</strong>,
        <strong>Python</strong> and <strong>PostgreSQL</strong>, with
        <strong>Node.js</strong> and Express where they suit the job better.
      </p>
      <p>
        I started with a Discord bot: a Pokémon collection game I co-created and
        was the only developer of until handing it over in 2022, sharding
        included. It now runs in 130,000+ servers under its current owner. Most
        of what I know about software that real people lean on started there.
      </p>
      <p>
        Right now I'm on contract at <strong>Hauldrive</strong>, a UK
        fleet-compliance platform, where I led backend design for a team of four
        and took the split from one Go backend into five services to production
        in October 2026. On the side I founded <strong>Finalist</strong>, a scrim
        and tournament platform for BGMI and Free Fire communities.
      </p>
      <p>
        I'm looking for a full-time remote role, full stack or backend, on a
        team that ships to real users.
      </p>
    </div>
  </Section>

  <Section
    standfirst="Where this was learned"
    title="Experience"
    lede="Three engagements, and what each one actually required. The Hauldrive entry is the current one and the deepest."
  >
    <Timeline items={experience} class="border-b border-line" />
  </Section>

  <Section
    standfirst="What I reach for"
    title="Tools and technologies"
    lede="What I reach for, grouped by where it sits in a system."
  >
    <dl class="border-t border-line">
      {
        skills.map((s) => (
          <div class="grid gap-x-6 gap-y-2 border-b border-line py-4 sm:grid-cols-[9.5rem_1fr]">
            <dt class="label pt-1">{s.group}</dt>
            <dd class="flex flex-wrap gap-x-3 gap-y-1.5 font-mono text-xs text-muted">
              {s.items.map((item) => (
                <span>{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section standfirst="For completeness" title="Education">
    <div class="border-y border-line py-6">
      <p class="font-mono text-xs text-faint">
        {education.period} · {education.location}
      </p>
      <h3 class="mt-2.5 font-semibold tracking-tight text-fg">
        {education.degree}
      </h3>
      <p class="mt-1 text-sm text-muted">{education.school}</p>
    </div>

    <!--
      The primary action here is the CV again.

      In v5 this led with "Start a project" and demoted the CV to a footnote,
      because the site was selling freelance work. It is a job search now, and a
      hiring manager on an about page wants the PDF. The freelance ask stays, one
      step down and named for what it is.
    -->
    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
      <Button variant="primary" href={RESUME_URL} target="_blank" rel="noopener">
        Download resume
        <Icon name="arrow-right" class="size-4" />
      </Button>
      <Button href={`mailto:${MAIL_ADDRESS}`}>
        <Icon name="mail" class="size-4" />
        Email me directly
      </Button>
      <a
        href="/services/"
        class="text-sm text-faint underline decoration-rule underline-offset-4 hover:text-accent hover:decoration-accent"
      >
        Freelance work, for clients
      </a>
    </div>
  </Section>

  <Cta />
</Base>
