---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/icons/Icon.astro";
import Button from "@/components/Button.astro";
import Timeline from "@/components/Timeline.astro";
import { experience } from "@/lib/experience";
import { MAIL_ADDRESS } from "@/lib/constants";

const skills: { group: string; items: string[] }[] = [
  { group: "Languages", items: ["Go", "TypeScript", "JavaScript", "Python", "SQL"] },
  { group: "Frontend", items: ["React", "Next.js", "Tailwind CSS", "TanStack Query", "Zustand", "Jotai"] },
  { group: "Backend", items: ["Gin", "Node.js", "NestJS", "Express", "WebSockets"] },
  { group: "Data", items: ["PostgreSQL", "Redis", "RabbitMQ"] },
  { group: "Infra", items: ["Docker", "AWS S3", "GitHub Actions", "Turborepo", "Vercel", "Linux"] },
  { group: "Tools", items: ["sqlc", "pgx", "Prisma", "Drizzle", "Stripe", "Zod"] },
];

const education = {
  school: "LNCT University, Bhopal",
  degree: "Bachelor of Computer Applications (BCA)",
  period: "2021 - 2024",
  location: "Bhopal, Madhya Pradesh, India",
};
---

<Base
  title="About"
  description="Full-stack engineer building scalable Go backends and modern React/Next.js applications."
>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">About</h1>

    <div class="prose mt-8">
      <p>
        I'm a full-stack engineer who builds scalable <strong>Go</strong>
        backends and modern <strong>React/Next.js</strong> applications. My
        day-to-day is production SaaS: RBAC, real-time infrastructure,
        compliance workflows, and the distributed services that hold them
        together.
      </p>
      <p>
        I started out on Linux and never left. I'm still pulled toward how
        systems actually work under the hood. What I care about most is backend
        architecture, developer tooling, and writing code that stays clean as
        it grows.
      </p>
      <p>
        Right now I'm leading a Go and Next.js platform rewrite at
        <strong>Hauldrive</strong>, and writing about the backend and systems
        work I pick up along the way.
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wider text-faint">
        Experience
      </h2>
      <Timeline items={experience} />
    </section>

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wider text-faint">
        Tools &amp; technologies
      </h2>
      <dl class="mt-5 space-y-4">
        {
          skills.map((s) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:gap-6">
              <dt class="w-28 shrink-0 font-mono text-sm text-faint">{s.group}</dt>
              <dd class="flex flex-wrap gap-1.5">
                {s.items.map((item) => (
                  <span class="rounded-md bg-surface px-2 py-0.5 font-mono text-xs text-muted">
                    {item}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-sm font-medium uppercase tracking-wider text-faint">
        Education
      </h2>
      <div class="mt-5">
        <p class="font-mono text-xs text-faint">
          {education.period} · {education.location}
        </p>
        <h3 class="mt-1 font-medium text-fg">{education.degree}</h3>
        <p class="text-sm text-muted">{education.school}</p>
      </div>
    </section>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href="/resume.pdf" target="_blank" rel="noopener">
        <Icon name="download" class="size-4" />
        Download Resume
      </Button>
      <Button variant="primary" href={`mailto:${MAIL_ADDRESS}`}>
        <Icon name="mail" class="size-4" />
        Get in touch
      </Button>
    </div>
  </div>
</Base>
