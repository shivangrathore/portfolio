---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/icons/Icon.astro";
import Cta from "@/components/Cta.astro";
import Price from "@/components/Price.astro";
import RegionToggle from "@/components/RegionToggle.astro";
// See index.astro: an unaliased `process` import shadows the Node global.
import {
  services,
  process as steps,
  faqs,
  WEEKLY_RATE,
  PROJECT_FROM,
  REVIEW_FROM,
} from "@/lib/services";
import { landings } from "@/lib/landings";
import { abs, breadcrumbs } from "@/lib/schema";

const description =
  "Hire a freelance AI and Go backend engineer for LLM features, performance work, MVP builds and multi-tenant SaaS. Rates in USD or INR, fixed milestones, code you own.";

// Prices sit in the header on purpose. Serious buyers scroll looking for a
// number, and the ones who leave when they find it were never going to book.
// Two cards, because a Bengaluru founder and a New York founder are not
// comparing me against the same alternative.
const rates = [
  { term: "Projects from", price: PROJECT_FROM },
  { term: "Weekly rate", price: WEEKLY_RATE },
  { term: "Review from", price: REVIEW_FROM },
];

const schema = [
  breadcrumbs([{ name: "Services", path: "/services" }]),
  {
    "@type": "ProfessionalService",
    "@id": `${abs("/services/")}#service`,
    name: "Shivang Rathore, freelance software engineering",
    url: abs("/services/"),
    description,
    provider: { "@id": `${abs("/")}#person` },
    // Named explicitly rather than left at "Worldwide": India is a market I
    // sell into on its own terms, with its own rate card, not a fallback.
    areaServed: [
      { "@type": "Country", name: "India" },
      { "@type": "Country", name: "United States" },
      { "@type": "Country", name: "United Kingdom" },
      "Worldwide",
    ],
    availableLanguage: ["English", "Hindi"],
    priceRange: "$$",
    currenciesAccepted: "USD, INR",
    paymentAccepted: "Bank transfer, Wise, UPI, NEFT",
    serviceType: services.map((s) => s.name),
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Engineering services",
      // One offer per currency, because the INR number is a different price
      // rather than a conversion of the USD one.
      itemListElement: services.flatMap((s) =>
        (["USD", "INR"] as const).map((currency) => ({
          "@type": "Offer",
          priceCurrency: currency,
          eligibleRegion:
            currency === "INR"
              ? { "@type": "Country", name: "India" }
              : undefined,
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: currency === "INR" ? s.startingAt.inr : s.startingAt.usd,
            priceCurrency: currency,
          },
          itemOffered: {
            "@type": "Service",
            name: s.name,
            description: s.tagline,
          },
        })),
      ),
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${abs("/services/")}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title="AI Engineering & Go Backend Services"
  description={description}
  schema={schema}
>
  <PageHeader
    label="Services"
    title="What I can build for you"
    lede="AI features that hold up in production and the backends that make them fast enough to use. Go and PostgreSQL for the parts that have to be correct, Next.js for the parts people touch. Scoped projects, fixed milestones, and code you own at the end."
  >
    <div slot="aside" class="lg:mt-11">
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3">
        <p class="label">Rates</p>
        <RegionToggle />
      </div>
      <dl class="border-t border-line">
        {
          rates.map((rate) => (
            <div class="grid grid-cols-[9.5rem_1fr] gap-4 border-b border-line py-4">
              <dt class="label pt-1">{rate.term}</dt>
              {/* The term already carries "from", so the value is bare. */}
              <dd class="font-mono text-sm text-fg">
                <Price price={rate.price} />
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-xs leading-relaxed text-faint">
        <span class="r-intl"
          >Quoted and invoiced in USD. Paid by bank transfer or Wise.</span
        ><span class="r-in"
          >Indian rate card, quoted and invoiced in INR. Paid by NEFT, IMPS or
          UPI.</span
        >
      </p>
    </div>
  </PageHeader>

  <!-- Services -->
  <Section
    index="01"
    title="The work"
    lede="Eight engagements. Each one lists what it includes, how long it usually runs and where it starts on price. AI and performance work sit first because that is what most of the last two years has been."
    seamless
  >
    <div class="border-t border-line">
      {
        services.map((service) => (
          <article class="border-b border-line py-8 first:pt-7">
            <div class="flex items-start gap-4">
              <span class="mt-1 shrink-0 text-accent">
                <Icon name={service.icon} class="size-5" />
              </span>
              <div class="min-w-0">
                <h3 class="text-heading">{service.name}</h3>
                <p class="measure mt-2 leading-relaxed text-muted">
                  {service.tagline}
                </p>
              </div>
            </div>

            <ul class="mt-6 grid gap-2.5 sm:grid-cols-2 sm:pl-9">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-6 border-t border-line pt-4 sm:pl-9">
              <p class="label">Right call when</p>
              <p class="measure mt-2 text-sm leading-relaxed text-muted">
                {service.goodFit}
              </p>
              <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs">
                <span class="text-faint">Typically {service.timeline}</span>
                <span aria-hidden="true" class="text-line">
                  |
                </span>
                <span class="text-fg">
                  From <Price price={service.startingAt} />
                </span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Deeper pages for the three things people hire me for most -->
  <Section
    index="02"
    title="Hiring for something specific?"
    lede="These go further: what the work includes, where I have done it before, and when I am the wrong person for it."
  >
    <div class="border-t border-line">
      {
        landings.map((landing) => (
          <a
            href={`/hire/${landing.slug}`}
            class="group flex items-start justify-between gap-6 border-b border-line py-5 transition-colors hover:bg-surface lg:px-4"
          >
            <span class="min-w-0">
              <span class="label block text-accent">{landing.eyebrow}</span>
              <span class="mt-2 block font-semibold tracking-tight text-fg group-hover:text-accent">
                {landing.heading}
              </span>
            </span>
            <Icon
              name="arrow-right"
              class="mt-1 size-4 shrink-0 text-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent"
            />
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Process -->
  <Section
    index="03"
    title="How it runs"
    lede="No long discovery phase, no surprise invoice at the end."
  >
    <ol class="border-t border-line">
      {
        steps.map((item, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-6 sm:gap-x-6">
            <span class="label pt-1.5 text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-semibold tracking-tight text-fg">{item.step}</h3>
              <p class="measure mt-1.5 text-sm leading-relaxed text-muted">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- FAQ -->
  <Section index="04" title="Common questions">
    <Faq items={faqs} />
  </Section>

  <Cta />
</Base>
