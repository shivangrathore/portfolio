---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/icons/Icon.astro";
import Cta from "@/components/Cta.astro";
import { services, process, faqs, usd, WEEKLY_RATE } from "@/lib/services";
import { landings } from "@/lib/landings";
import { abs, breadcrumbs } from "@/lib/schema";

const description =
  "Hire a freelance Go and Next.js developer for MVP builds, backend APIs and multi-tenant SaaS. Fixed milestones, clear scope, code you own.";

const schema = [
  breadcrumbs([{ name: "Services", path: "/services" }]),
  {
    "@type": "ProfessionalService",
    "@id": `${abs("/services/")}#service`,
    name: "Shivang Rathore, freelance software engineering",
    url: abs("/services/"),
    description,
    provider: { "@id": `${abs("/")}#person` },
    areaServed: "Worldwide",
    availableLanguage: "English",
    priceRange: "$$",
    currenciesAccepted: "USD",
    paymentAccepted: "Bank transfer, Wise",
    serviceType: services.map((s) => s.name),
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Engineering services",
      itemListElement: services.map((s) => ({
        "@type": "Offer",
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "PriceSpecification",
          minPrice: s.startingAt,
          priceCurrency: "USD",
        },
        itemOffered: {
          "@type": "Service",
          name: s.name,
          description: s.tagline,
        },
      })),
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${abs("/services/")}#faq`,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title="Go Backend & MVP Development Services" description={description} schema={schema}>
  <!-- Header -->
  <section class="mx-auto max-w-3xl px-5 pb-10 pt-16 md:pt-20">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/40 px-3 py-1 text-xs text-muted"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      Taking new projects
    </span>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight md:text-4xl">
      What I can build for you
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      I work with founders and product teams who need a backend that holds up.
      Go and PostgreSQL for the parts that have to be correct, Next.js for the
      parts people touch. Scoped projects, fixed milestones, and code you own at
      the end.
    </p>

    <!--
      Prices sit above the fold on purpose. Serious buyers scroll looking for a
      number, and the ones who leave when they find it were never going to book.
    -->
    <dl
      class="mt-7 grid max-w-xl grid-cols-2 gap-x-6 gap-y-4 border-t border-border/60 pt-6 font-mono text-xs sm:grid-cols-3"
    >
      <div>
        <dt class="text-faint">Projects from</dt>
        <dd class="mt-1 text-fg">{usd(1500)} USD</dd>
      </div>
      <div>
        <dt class="text-faint">Weekly rate</dt>
        <dd class="mt-1 text-fg">{usd(WEEKLY_RATE)} USD</dd>
      </div>
      <div>
        <dt class="text-faint">US overlap</dt>
        <dd class="mt-1 text-fg">4 hrs daily</dd>
      </div>
    </dl>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-3xl px-5 py-8">
    <div class="grid gap-4">
      {
        services.map((service) => (
          <article class="rounded-xl border border-border bg-surface/40 p-6 sm:p-7">
            <div class="flex items-start gap-4">
              <span class="mt-0.5 shrink-0 rounded-lg border border-border bg-bg p-2 text-accent">
                <Icon name={service.icon} class="size-5" />
              </span>
              <div class="min-w-0">
                <h2 class="text-lg font-semibold tracking-tight">{service.name}</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">
                  {service.tagline}
                </p>
              </div>
            </div>

            <ul class="mt-5 grid gap-2 sm:grid-cols-2">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-5 border-t border-border/60 pt-4">
              <p class="text-sm text-muted">
                <span class="font-mono text-xs uppercase tracking-wider text-faint">
                  Right call when
                </span>
                <span class="mt-1 block">{service.goodFit}</span>
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs">
                <span class="inline-flex items-center gap-1.5 text-faint">
                  <Icon name="clock" class="size-3.5" />
                  Typically {service.timeline}
                </span>
                <span class="text-fg">
                  From {usd(service.startingAt)}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Deeper pages for the three things people hire me for most -->
  <section class="mx-auto max-w-3xl px-5 pt-8">
    <div class="rounded-xl border border-border bg-surface/40 p-6 sm:p-7">
      <h2 class="text-lg font-semibold tracking-tight">
        Hiring for something specific?
      </h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
        These three go further: what the work includes, where I have done it
        before, and when I am the wrong person for it.
      </p>
      <ul class="mt-5 grid gap-2.5">
        {
          landings.map((landing) => (
            <li>
              <a
                href={`/hire/${landing.slug}`}
                class="group inline-flex items-center gap-2 text-sm text-fg hover:text-accent"
              >
                {landing.heading}
                <Icon
                  name="arrow-right"
                  class="size-3.5 text-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h2 class="text-lg font-semibold tracking-tight">How it runs</h2>
    <p class="mt-2 max-w-xl text-sm text-muted">
      No long discovery phase, no surprise invoice at the end.
    </p>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        process.map((item, i) => (
          <li class="rounded-xl border border-border bg-surface/40 p-5">
            <span class="font-mono text-xs text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 font-semibold tracking-tight">{item.step}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h2 class="text-lg font-semibold tracking-tight">Common questions</h2>
    <div class="mt-6 divide-y divide-border/60 rounded-xl border border-border bg-surface/40">
      {
        faqs.map((faq) => (
          <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-fg">
              {faq.q}
              <Icon
                name="arrow-right"
                class="size-4 shrink-0 text-faint transition-transform group-open:rotate-90"
              />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <Cta />
</Base>
