---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Button from "@/components/Button.astro";
import Timeline from "@/components/Timeline.astro";
import Cta from "@/components/Cta.astro";
import Github from "@/components/icons/Github.astro";
import Icon from "@/components/icons/Icon.astro";
import { GITHUB_URL, NAV_ITEMS } from "@/lib/constants";
import { abs } from "@/lib/schema";
import { services } from "@/lib/services";
import { experience } from "@/lib/experience";
import { formatDate } from "@/lib/utils";

const isDev = import.meta.env.DEV;
const visible = <T extends { data: { draft: boolean } }>(items: T[]) =>
  isDev ? items : items.filter((i) => !i.data.draft);

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.order - a.data.order,
);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);

const posts = visible(await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const studies = visible(await getCollection("caseStudies")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const writing = [
  ...studies.map((s) => ({ kind: "Case study", entry: s, base: "/case-studies/" })),
  ...posts.map((p) => ({ kind: "Blog", entry: p, base: "/blog/" })),
]
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 4);
---

<Base
  schema={[
    {
      "@type": "WebPage",
      "@id": `${abs("/")}#webpage`,
      url: abs("/"),
      name: "Shivang Rathore",
      about: { "@id": `${abs("/")}#person` },
      isPartOf: { "@id": `${abs("/")}#website` },
    },
    ...NAV_ITEMS.map((item) => ({
      "@type": "SiteNavigationElement",
      name: item.name,
      url: abs(item.href),
    })),
  ]}
>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-5 pb-14 pt-12 sm:pt-20 md:pt-28">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/40 px-3 py-1 text-xs text-muted"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      Taking new projects
    </span>
    <h1
      class="mt-5 text-[2.1rem] font-semibold leading-[1.1] tracking-tight text-balance sm:text-5xl md:text-[3.4rem]"
    >
      I build MVPs with backends
      <span class="text-accent sm:block">that don't buckle later</span>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted sm:mt-6">
      Freelance full-stack engineer. I take founders from an idea to something
      running in production, then keep it standing as it grows. Go and
      PostgreSQL for the parts that have to be correct, Next.js for the parts
      people touch.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <Button variant="primary" href="/contact" class="justify-center sm:justify-start">
        Start a project
        <Icon name="arrow-right" class="size-4" />
      </Button>
      <Button href="/services" class="justify-center sm:justify-start">
        What I build
      </Button>
    </div>

    <!-- Sits directly under the buttons, where the hesitation actually happens. -->
    <p class="mt-4 text-sm text-faint">
      No obligation. I reply to every enquiry within 24 hours.
    </p>

    <dl
      class="mt-10 flex flex-col gap-4 border-t border-border/60 pt-8 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-5"
    >
      <div class="flex items-baseline gap-3 sm:block">
        <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-faint sm:w-auto">
          Core stack
        </dt>
        <dd class="text-sm text-fg sm:mt-1.5">Go · PostgreSQL · Next.js</dd>
      </div>
      <div class="flex items-baseline gap-3 sm:block">
        <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-faint sm:w-auto">
          Works from
        </dt>
        <dd class="text-sm text-fg sm:mt-1.5">Remote · India (IST)</dd>
      </div>
      <div class="flex items-baseline gap-3 sm:block">
        <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wider text-faint sm:w-auto">
          Available
        </dt>
        <dd class="text-sm text-fg sm:mt-1.5">One project at a time</dd>
      </div>
    </dl>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-semibold tracking-tight">What I can build</h2>
      <a href="/services" class="text-sm text-muted hover:text-accent">
        Scope and pricing →
      </a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        services.slice(0, 4).map((service) => (
          <a
            href="/services"
            class="group rounded-xl border border-border bg-surface/40 p-5 transition-colors hover:border-accent/50"
          >
            <span class="inline-flex rounded-lg border border-border bg-bg p-2 text-accent">
              <Icon name={service.icon} class="size-4" />
            </span>
            <h3 class="mt-3 font-semibold tracking-tight group-hover:text-accent">
              {service.name}
            </h3>
            <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">
              {service.tagline}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Selected work -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Selected work</h2>
      <a href="/work" class="text-sm text-muted hover:text-accent">All projects →</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Experience -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Where I have done this</h2>
      <a href="/about" class="text-sm text-muted hover:text-accent">
        Full background →
      </a>
    </div>
    <Timeline items={experience.slice(0, 2)} />
  </section>

  <!-- Writing -->
  <section class="mx-auto max-w-3xl px-5 py-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Writing</h2>
      <a href="/blog" class="text-sm text-muted hover:text-accent">All posts →</a>
    </div>
    <div class="mt-6 grid gap-4">
      {
        writing.map(({ kind, entry, base }) => (
          <a
            href={`${base}${entry.id}`}
            class="group rounded-xl border border-border bg-surface/40 p-6 transition-colors hover:border-accent/50"
          >
            <div class="flex items-center gap-3 font-mono text-xs text-faint">
              <span class="rounded-full bg-accent/10 px-2 py-0.5 text-accent">
                {kind}
              </span>
              <time datetime={entry.data.pubDate.toISOString()}>
                {formatDate(entry.data.pubDate)}
              </time>
            </div>
            <h3 class="mt-3 text-lg font-semibold text-fg group-hover:text-accent">
              {entry.data.title}
            </h3>
            <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">
              {entry.data.description}
            </p>
            {entry.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {entry.data.tags.slice(0, 4).map((tag) => (
                  <span class="rounded-full border border-border px-2 py-0.5 text-xs text-faint">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contact CTA -->
  <Cta />
</Base>
