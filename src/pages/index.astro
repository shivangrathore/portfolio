---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Section from "@/components/Section.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import PostRow from "@/components/PostRow.astro";
import Button from "@/components/Button.astro";
import Cta from "@/components/Cta.astro";
import Timeline from "@/components/Timeline.astro";
import Icon from "@/components/icons/Icon.astro";
import { NAV_ITEMS, RESUME_URL, MAIL_ADDRESS, AVAILABILITY } from "@/lib/constants";
import { evidence } from "@/lib/pitch";
import { experience } from "@/lib/experience";
import { abs } from "@/lib/schema";

const isDev = import.meta.env.DEV;
const visible = <T extends { data: { draft: boolean } }>(items: T[]) =>
  isDev ? items : items.filter((i) => !i.data.draft);

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.order - a.data.order,
);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
// The top project carries the section on its own. The rest are rows under it,
// because three equal-weight entries make a visitor choose where to look.
const [lead, ...rest] = featured;

// Posts written to sell freelance work (rates, hiring a freelancer) stay on
// /blog but not here: on a page a hiring manager reads, they change the subject.
const CLIENT_TAGS = ["Freelance", "Pricing"];
const posts = visible(await getCollection("blog"))
  .filter((p) => !p.data.tags.some((t) => CLIENT_TAGS.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const studies = visible(await getCollection("caseStudies")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const writing = [
  ...studies.map((s) => ({ kind: "Case study", entry: s, base: "/case-studies/" })),
  ...posts.map((p) => ({ kind: "Blog", entry: p, base: "/blog/" })),
]
  .sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 3);

// The homepage, rebuilt for the job search.
//
// v5 was a freelance funnel: a free call as the offer, the problems a founder
// recognises, the alternatives priced, the rate card and the objections. Every
// one of those answers a buyer's question. A hiring manager asks different ones,
// in this order: what do you do, what have you shipped, where, and how do I get
// the CV. The page now answers those and nothing else. The freelance pages are
// untouched and one click away in the footer.
---

<Base
  schema={[
    {
      "@type": "WebPage",
      "@id": `${abs("/")}#webpage`,
      url: abs("/"),
      name: "Shivang Rathore",
      about: { "@id": `${abs("/")}#person` },
      isPartOf: { "@id": `${abs("/")}#website` },
    },
    ...NAV_ITEMS.map((item) => ({
      "@type": "SiteNavigationElement",
      name: item.name,
      url: abs(item.href),
    })),
  ]}
>
  <!--
    Hero.

    The role first, then the claim, then the proof in the band below. The
    headline is short on purpose: at display size anything past seven words
    wraps to four lines and pushes the buttons under the fold on a laptop.
  -->
  <section class="border-b border-line">
    <div class="shell grid gap-x-14 gap-y-12 pb-20 pt-14 md:pb-24 md:pt-20 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="standfirst">Full stack engineer, India</p>

        <!-- No text-balance: it evens the line lengths, which pulls the
             headline in to about 60% of the column and leaves a hole. -->
        <h1 class="expanded mt-6 text-display">
          I build software people <span class="text-accent">use</span>.
        </h1>

        <p class="measure mt-8 text-lede text-pretty text-muted">
          I am Shivang, building software since 2019: TypeScript and React on the
          front, Go, Python and PostgreSQL behind it. Today I am a contract
          engineer on a UK fleet-compliance platform, and the founder of
          Finalist, an esports platform for competitive gaming communities.
        </p>

        <div class="mt-10 flex flex-col items-start gap-x-9 gap-y-2 sm:flex-row sm:items-center">
          <Button variant="primary" href={RESUME_URL} target="_blank" rel="noopener">
            Download résumé
            <Icon name="arrow-right" class="size-4" />
          </Button>
          <Button href={`mailto:${MAIL_ADDRESS}`}>
            <Icon name="mail" class="size-4" />
            {MAIL_ADDRESS}
          </Button>
        </div>

        <!-- Sits directly under the buttons, where the recruiter's first
             filter question is answered before it is asked. -->
        <p class="mt-5 text-sm text-faint">{AVAILABILITY}</p>
      </div>

      <!--
        The colophon rail. Four facts a recruiter checks before reading any
        further: what kind of role, when you could start, where you are, and
        what you work in. The stack last and quietest.
      -->
      <aside class="lg:col-span-3 lg:col-start-10">
        <dl class="border-t-[3px] border-fg">
          <div class="border-b border-line py-4">
            <dt class="spec">Looking for</dt>
            <dd class="mt-1.5 text-lg font-bold tracking-tight text-accent">
              Full-time remote, full stack or backend
            </dd>
          </div>

          <div class="grid grid-cols-2 gap-x-4 border-b border-line py-4">
            <div>
              <dt class="spec">Notice</dt>
              <dd class="expanded mt-1.5 text-2xl font-bold tracking-tight text-fg">
                30 days
              </dd>
            </div>
            <div>
              <dt class="spec">Based in</dt>
              <dd class="expanded mt-1.5 text-2xl font-bold tracking-tight text-fg">
                India
              </dd>
            </div>
          </div>

          <div class="border-b border-line py-4">
            <dt class="spec">Hours</dt>
            <dd class="mt-1.5 text-lg font-bold tracking-tight text-fg">
              IST, with UK overlap daily
            </dd>
          </div>

          <div class="py-4">
            <dt class="spec">Works in</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-muted">
              TypeScript · React · Next.js · Go · Python · PostgreSQL
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!--
    Evidence, on the blue.

    Directly under the hero, because the headline makes a claim and this is the
    first thing that substantiates one. Every figure matches the résumé.
  -->
  <section class="band-accent">
    <div class="shell py-16 md:py-20">
      <p
        class="condensed text-xs font-bold uppercase tracking-[0.1em] opacity-80"
      >
        Running in production, with real users behind it
      </p>
      <dl class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          evidence.map((point) => (
            <div>
              <dt class="expanded text-6xl font-bold leading-none tracking-tight tabular-nums">
                {point.value}
              </dt>
              <dd class="mt-5 text-sm leading-relaxed opacity-90">
                {point.label}
                <span class="mt-3 block font-mono text-xs tracking-tight opacity-75">
                  {point.href ? (
                    <a href={point.href} class="underline underline-offset-4">
                      {point.source}
                    </a>
                  ) : (
                    point.source
                  )}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Experience, the same timeline as /about, so the two cannot drift. -->
  <Section
    standfirst="Where this was learned"
    title="Experience"
    lede="A contract engagement on a production platform, the year before it, and the bot I started on."
    href="/about/"
    linkLabel="More about me"
    tinted
  >
    <Timeline items={experience} class="border-b border-line" />
  </Section>

  <!-- Selected work: one lead project, then the rest as rows -->
  <Section
    standfirst="Things that shipped"
    title="Selected work"
    lede="Products with users behind them, and what each one had to survive."
    href="/work/"
    linkLabel="All projects"
  >
    {
      lead && (
        <article class="border-t-[3px] border-fg pt-7">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <span class="standfirst">Current build</span>
            <span class="spec">{lead.data.date}</span>
          </div>

          <h3 class="mt-4 text-title text-balance">
            {lead.data.demo ? (
              <a
                href={lead.data.demo}
                target="_blank"
                rel="noopener"
                class="hover:text-accent"
              >
                {lead.data.title}
              </a>
            ) : (
              lead.data.title
            )}
          </h3>

          <p class="measure mt-6 text-lede text-pretty text-muted">
            {lead.data.description}
          </p>

          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {lead.data.features.slice(0, 4).map((feature) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="spec mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-4">
            {lead.data.technologies.slice(0, 6).map((tech) => (
              <span>{tech}</span>
            ))}
            {lead.data.technologies.length > 6 && (
              <span>+{lead.data.technologies.length - 6}</span>
            )}
          </div>
        </article>
      )
    }

    <div class="mt-12 border-b border-line">
      {rest.map((project, i) => <ProjectRow project={project} index={i + 2} />)}
    </div>
  </Section>

  <!-- Writing -->
  <Section
    standfirst="Thinking out loud"
    title="Writing"
    lede="Decisions from things that shipped, written up while they were still fresh."
    href="/blog/"
    linkLabel="All posts"
    tinted
  >
    <div class="border-t-[3px] border-fg">
      {
        writing.map(({ kind, entry, base }) => (
          <PostRow
            href={`${base}${entry.id}/`}
            kind={kind}
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
          />
        ))
      }
    </div>
  </Section>

  <!-- Contact CTA -->
  <Cta />
</Base>
